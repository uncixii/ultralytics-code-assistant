# Copy to .env locally or pass --env-file to a command. Never commit real values.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/?retryWrites=true&w=majority
MONGODB_DB=ultralytics_code_assistant
MONGODB_COLLECTION=code_chunks
MONGODB_VECTOR_INDEX=code_vector_index
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-code
